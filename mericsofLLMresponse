"""
LLM Hallucination Evaluation Toolkit
----------------------------------
Evaluates multiple QA consistency & hallucination-related criteria on LLM outputs.
Designed to be MODEL-AGNOSTIC (plug in OpenAI, Azure, local LLM, etc.)

Criteria Covered:
1. Prompt Perturbation (Systematic Prompting)
2. Self-Consistency Scoring
3. Source Grounding (RAG)
4. Faithfulness / Entailment
5. Relevancy
6. Internal Consistency
7. Factual Accuracy Checks

"""

from typing import List, Dict, Callable
import itertools
import numpy as np
from sklearn.metrics.pairwise import cosine_similarity
import requests
import httpx

OLLAMA_URL = "http://localhost:11434/api/embeddings"
OLLAMA_MODEL = "nomic-embed-text"   # or mxbai-embed-large


def embed(texts):
    embeddings = []
    for text in texts:
        response = requests.post(
            OLLAMA_URL,
            json={
                "model": OLLAMA_MODEL,
                "prompt": text
            }
        )
        response.raise_for_status()
        embeddings.append(response.json()["embedding"])

    return np.array(embeddings)

# ==========================
# 1. Prompt Perturbation
# ==========================

def prompt_perturbation(
    base_prompt: str,
    perturbations: List[str],
    llm_call: Callable[[str], str]
) -> Dict:
    """
    Measures stability of answers under prompt variations
    """
    outputs = [llm_call(p) for p in perturbations]
    embeddings = embed(outputs)

    sims = []
    for i, j in itertools.combinations(range(len(embeddings)), 2):
        sims.append(cosine_similarity([embeddings[i]], [embeddings[j]])[0][0])

    return {
        "mean_similarity": float(np.mean(sims)),
        "std_dev": float(np.std(sims)),
        "outputs": outputs
    }


# ==========================
# 2. Self-Consistency Scoring
# ==========================

def self_consistency(
    prompt: str,
    llm_call: Callable[[str], str],
    n_samples: int = 5
) -> Dict:
    outputs = [llm_call(prompt) for _ in range(n_samples)]
    embeddings = embed(outputs)

    sim_matrix = cosine_similarity(embeddings)
    avg_consistency = float(np.mean(sim_matrix))

    return {
        "self_consistency_score": avg_consistency,
        "outputs": outputs
    }


# ==========================
# 3. Source Grounding (RAG)
# ==========================

def source_grounding(answer: str, sources: List[str]) -> Dict:
    answer_emb = embed([answer])[0]
    source_embs = embed(sources)

    sims = cosine_similarity([answer_emb], source_embs)[0]

    return {
        "max_grounding_score": float(np.max(sims)),
        "avg_grounding_score": float(np.mean(sims)),
        "per_source_scores": sims.tolist()
    }


# ==========================
# 4. Faithfulness / Entailment
# ==========================

def faithfulness(answer: str, context: str) -> Dict:
    """
    Approximate entailment via semantic similarity
    (Can be replaced with NLI model like roberta-large-mnli)
    """
    emb = embed([answer, context])
    score = cosine_similarity([emb[0]], [emb[1]])[0][0]

    return {"faithfulness_score": float(score)}


# ==========================
# 5. Relevancy
# ==========================

def relevancy(query: str, answer: str) -> Dict:
    emb = embed([query, answer])
    score = cosine_similarity([emb[0]], [emb[1]])[0][0]

    return {"relevancy_score": float(score)}


# ==========================
# 6. Internal Consistency
# ==========================

def internal_consistency(answer: str) -> Dict:
    """
    Checks contradiction between sentences in the same answer
    """
    sentences = [s.strip() for s in answer.split('.') if len(s.strip()) > 10]
    if len(sentences) < 2:
        return {"internal_consistency": 1.0}

    emb = embed(sentences)
    sim_matrix = cosine_similarity(emb)

    return {
        "internal_consistency": float(np.mean(sim_matrix))
    }


# ==========================
# 7. Factual Accuracy (Lightweight)
# ==========================

def factual_accuracy(answer: str, known_facts: List[str]) -> Dict:
    """
    Compares answer against verified facts
    """
    answer_emb = embed([answer])[0]
    fact_embs = embed(known_facts)

    sims = cosine_similarity([answer_emb], fact_embs)[0]

    return {
        "max_fact_match": float(np.max(sims)),
        "avg_fact_match": float(np.mean(sims))
    }


# ==========================
# Unified Evaluation Runner
# ==========================

def evaluate_all(
    query: str,
    answer: str,
    llm_call: Callable[[str], str],
    context: str = None,
    sources: List[str] = None,
    known_facts: List[str] = None
) -> Dict:

    results = {
        "relevancy": relevancy(query, answer),
        "internal_consistency": internal_consistency(answer)
    }

    if context:
        results["faithfulness"] = faithfulness(answer, context)

    if sources:
        results["source_grounding"] = source_grounding(answer, sources)

    if known_facts:
        results["factual_accuracy"] = factual_accuracy(answer, known_facts)

    return results


